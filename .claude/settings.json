{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.crt)",
      "Read(./**/*.key)",
      "Read(./**/*.dump)",
      "Read(./**/*.sqlite3)"
    ]
  }
}